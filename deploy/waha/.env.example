# Copy to .env on the server and replace every placeholder.
WAHA_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Keep WAHA on the free ARM VM; do not expose port 3000 directly to the internet
# when a TLS reverse proxy is configured.
WHATSAPP_DEFAULT_ENGINE=NOWEB
